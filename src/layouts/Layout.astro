---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Preloader from "../components/Preloader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Wivork | We Made Real",
  description = "Custom 3D portraits and unique collectibles. We turn your digital moments into beautifully crafted physical pieces you can hold. Based in Colombo, Sri Lanka.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/YFAVICON.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!--
      Live font finder. Shows on localhost (or add ?fonts to any URL).
      Choices persist in localStorage. Once you pick, tell Claude the three names
      and they get self-hosted.
    -->
    <script is:inline>
      (function () {
        var D = [
          ["Bricolage Grotesque", "Bricolage+Grotesque:wght@400;500;600;700"],
          ["Unbounded", "Unbounded:wght@400;500;600"],
          ["Syne", "Syne:wght@400;500;600;700"],
          ["Space Grotesk", "Space+Grotesk:wght@400;500;600;700"],
          ["Sora", "Sora:wght@400;500;600;700"],
          ["Outfit", "Outfit:wght@400;500;600;700"],
          ["Manrope", "Manrope:wght@400;500;600;700"],
          ["Inter Tight", "Inter+Tight:wght@400;500;600;700"],
          ["Familjen Grotesk", "Familjen+Grotesk:wght@400;500;600;700"],
          ["Archivo", "Archivo:wght@400;500;600;700"],
          ["Big Shoulders Display", "Big+Shoulders+Display:wght@400;500;600;700"],
          ["Anton", "Anton"],
        ];
        var S = [
          ["Instrument Serif", "Instrument+Serif:ital@0;1"],
          ["Fraunces", "Fraunces:ital,wght@0,400;1,400"],
          ["DM Serif Display", "DM+Serif+Display:ital@0;1"],
          ["Playfair Display", "Playfair+Display:ital,wght@0,400;1,400"],
          ["Cormorant Garamond", "Cormorant+Garamond:ital,wght@0,400;1,400"],
          ["Newsreader", "Newsreader:ital,wght@0,400;1,400"],
        ];
        var B = [
          ["Inter Tight", "Inter+Tight:wght@400;500;600"],
          ["Manrope", "Manrope:wght@400;500;600"],
          ["DM Sans", "DM+Sans:wght@400;500;600"],
          ["Figtree", "Figtree:wght@400;500;600"],
          ["Hanken Grotesk", "Hanken+Grotesk:wght@400;500;600"],
          ["Space Grotesk", "Space+Grotesk:wght@400;500;600"],
        ];
        var KEY = "wivork-fonts";
        var cur = { d: "Bricolage Grotesque", s: "Instrument Serif", b: "Inter Tight" };
        try {
          var saved = JSON.parse(localStorage.getItem(KEY) || "null");
          if (saved) for (var k in saved) cur[k] = saved[k];
        } catch (e) {}

        function spec(list, name) {
          for (var i = 0; i < list.length; i++) if (list[i][0] === name) return list[i][1];
        }
        function load(list, name) {
          var s = spec(list, name);
          if (!s || document.querySelector('link[data-f="' + name + '"]')) return;
          var l = document.createElement("link");
          l.rel = "stylesheet";
          l.setAttribute("data-f", name);
          l.href = "https://fonts.googleapis.com/css2?family=" + s + "&display=swap";
          document.head.appendChild(l);
        }
        function apply() {
          var r = document.documentElement.style;
          r.setProperty("--fd", '"' + cur.d + '"');
          r.setProperty("--fs", '"' + cur.s + '"');
          r.setProperty("--fb", '"' + cur.b + '"');
          load(D, cur.d);
          load(S, cur.s);
          load(B, cur.b);
          try {
            localStorage.setItem(KEY, JSON.stringify(cur));
          } catch (e) {}
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
              window.dispatchEvent(new Event("fontschange"));
            });
          }
        }
        apply();

        function panel() {
          var show = /localhost|127\.0\.0\.1/.test(location.hostname) || /[?&]fonts/.test(location.search);
          if (!show) return;
          var wrap = document.createElement("div");
          wrap.setAttribute("data-lenis-prevent", "");
          wrap.style.cssText =
            "position:fixed;left:16px;bottom:16px;z-index:200;font:13px/1.3 system-ui,sans-serif;color:#f6f5fb";
          var btn = document.createElement("button");
          btn.textContent = "Aa";
          btn.title = "Font finder";
          btn.style.cssText =
            "width:44px;height:44px;border-radius:999px;border:1px solid #2b3050;background:#0d0f1aee;color:#f4a950;font:600 16px system-ui;cursor:pointer;backdrop-filter:blur(8px)";
          var box = document.createElement("div");
          box.style.cssText =
            "display:none;margin-bottom:10px;width:260px;padding:14px;border-radius:16px;border:1px solid #2b3050;background:#0d0f1af2;backdrop-filter:blur(10px)";
          function row(label, list, key) {
            var d = document.createElement("label");
            d.style.cssText = "display:block;margin-bottom:10px";
            var t = document.createElement("div");
            t.textContent = label;
            t.style.cssText = "opacity:.6;margin-bottom:4px;letter-spacing:.08em;text-transform:uppercase;font-size:11px";
            var sel = document.createElement("select");
            sel.style.cssText =
              "width:100%;padding:6px 8px;border-radius:8px;border:1px solid #2b3050;background:#141728;color:#f6f5fb;font:13px system-ui";
            list.forEach(function (f) {
              var o = document.createElement("option");
              o.value = o.textContent = f[0];
              if (cur[key] === f[0]) o.selected = true;
              sel.appendChild(o);
            });
            sel.onchange = function () {
              cur[key] = sel.value;
              apply();
            };
            // arrow keys step through the list while the select is focused (native), buttons too
            var step = document.createElement("div");
            step.style.cssText = "display:flex;gap:6px;margin-top:6px";
            ["‹", "›"].forEach(function (c, n) {
              var b = document.createElement("button");
              b.textContent = c;
              b.style.cssText =
                "flex:1;padding:4px;border-radius:8px;border:1px solid #2b3050;background:#141728;color:#f6f5fb;cursor:pointer";
              b.onclick = function () {
                var i = sel.selectedIndex + (n ? 1 : -1);
                sel.selectedIndex = (i + list.length) % list.length;
                sel.onchange();
              };
              step.appendChild(b);
            });
            d.appendChild(t);
            d.appendChild(sel);
            d.appendChild(step);
            return d;
          }
          box.appendChild(row("Headlines", D, "d"));
          box.appendChild(row("Italic accent", S, "s"));
          box.appendChild(row("Body", B, "b"));
          var copy = document.createElement("button");
          copy.textContent = "Copy my choice";
          copy.style.cssText =
            "width:100%;padding:8px;border-radius:999px;border:0;background:#f4a950;color:#07080f;font:600 13px system-ui;cursor:pointer";
          copy.onclick = function () {
            var txt = "Headlines: " + cur.d + " | Accent: " + cur.s + " | Body: " + cur.b;
            if (navigator.clipboard) navigator.clipboard.writeText(txt);
            copy.textContent = "Copied: " + txt;
          };
          box.appendChild(copy);
          btn.onclick = function () {
            box.style.display = box.style.display === "none" ? "block" : "none";
          };
          wrap.appendChild(box);
          wrap.appendChild(btn);
          document.body.appendChild(wrap);
        }
        document.addEventListener("DOMContentLoaded", panel);
      })();
    </script>
  </head>
  <body class="is-loading">
    <Preloader />
    <Header />
    <slot />
    <script>
      import { init } from "../lib/scroll";
      init();
    </script>
  </body>
</html>
